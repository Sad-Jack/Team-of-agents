LLM_PROVIDER=fake

# Managed project
# "." means the current repository is managed.
# ".." means Team of Agents is embedded inside another project.
MANAGED_REPO_PATH=.

# Storage
STORAGE_BACKEND=json
SQLITE_DB_PATH=data/team_agents.db

# For real local usage with Claude Code:
# LLM_PROVIDER=claude_code
CLAUDE_CODE_BINARY=claude
CLAUDE_CODE_TIMEOUT_SECONDS=120

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Telegram safety
TELEGRAM_DRY_RUN_BY_DEFAULT=true

# Debug mode: show technical details (intent, action name, raw args) in Telegram messages.
# false by default — shows clean Russian messages instead.
TELEGRAM_DEBUG_MODE=false

# Fast router: handle simple read-only queries locally without calling the LLM.
# true by default — saves tokens for common queries like "статус", "покажи задачи", etc.
TELEGRAM_FAST_ROUTER_ENABLED=true

# Telegram status notifications (optional)
# Set TELEGRAM_STATUS_CHAT_ID to a chat/channel ID to receive agent/task event notifications.
# To get your chat ID: forward a message to @userinfobot or use /start in your status channel.
TELEGRAM_STATUS_CHAT_ID=
TELEGRAM_NOTIFY_AGENT_EVENTS=true
TELEGRAM_NOTIFY_TASK_EVENTS=true

# Speech-to-text / voice input
STT_PROVIDER=disabled
FFMPEG_BINARY=ffmpeg
VOICE_WORK_DIR=.tmp/voice

# For local Whisper CLI usage:
# STT_PROVIDER=whisper_cli
WHISPER_CLI_BINARY=whisper
WHISPER_MODEL=small
WHISPER_LANGUAGE=ru

# Optional custom CLI:
# STT_PROVIDER=custom_cli
# STT_CUSTOM_COMMAND=

# Optional legacy/API providers:
OPENAI_API_KEY=
OPENAI_MODEL=

# Telegram Board / Admin Room
# The bot can publish project events into a Telegram forum group.
# Each project area has its own topic (forum thread).
# Topic ids are the message_thread_id of each forum topic (integer).
# Get them from the topic link: t.me/c/3952202151/10 → chat_id=-1003952202151, topic_id=10
# Board is disabled by default; missing topic ids are silently skipped.
TELEGRAM_BOARD_ENABLED=false
TELEGRAM_BOARD_CHAT_ID=
# Timeout for sending messages to Board topics (seconds). Default: 20.
# Increase if you see "⚠️ timeout" in board-ping results.
TELEGRAM_BOARD_SEND_TIMEOUT_SECONDS=20

TELEGRAM_TOPIC_TASK_IDEAS=
TELEGRAM_TOPIC_TASK_READY=
TELEGRAM_TOPIC_TASK_ACTIVE=
TELEGRAM_TOPIC_TASK_BLOCKED=

TELEGRAM_TOPIC_BUGS_NEW=
TELEGRAM_TOPIC_BUGS_ACTIVE=
TELEGRAM_TOPIC_NEEDS_INPUT=

TELEGRAM_TOPIC_RELEASES=
TELEGRAM_TOPIC_AGENT_LOG=
TELEGRAM_TOPIC_DECISIONS=
